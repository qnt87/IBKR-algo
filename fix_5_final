# =====================================================================================
#  BUY-WRITE BASKET ENGINE  --  "SAFE" VERSION
#
#  Everything marked [FIX-n] was added to stop the engine from ever ending up SHORT
#  stock (borrowed shares) again, and to stop short-sale proceeds from being treated
#  as spendable cash.
#
#   [FIX-1] ONE gate for every stock SELL (safe_sell_shares): never sells more than the
#           broker's last completed snapshot shows, never while another share order for
#           that symbol is working, never off a snapshot older than the last share order.
#   [FIX-2] Warnings (e.g. 10349 "TIF set to DAY") no longer wipe order-tracking state;
#           only real failures do. This was making the orphan sweep sell twice.
#   [FIX-3] openOrder ignores callbacks for orders that already finished.
#   [FIX-4] Solvency close is throttled (it used to fire EVERY SECOND) and is now driven
#           by EXCESS LIQUIDITY, not raw cash. Negative cash alone is no longer a breach.
#   [FIX-5] Any SHORT stock position in a tracked symbol is detected and bought back.
#   [FIX-6] Spendable cash excludes short-sale proceeds and is capped by excess liquidity.
#           New trades are blocked entirely while any short stock exists.
#   [FIX-7] No new buy-write on a symbol while a share/combo order is working, or while
#           the broker still shows shares of it.
#   [FIX-8] Bare-share recycling never sells shares that back a short call at the broker.
#   [FIX-9] reqIds start high so a market-data error can never be mistaken for an order.
#   [FIX-10] Hard cap on total long stock exposure vs Net Liquidation (no margin borrowing).
#   [FIX-11] Shares are never sold while their covering call's buy-to-close is still
#            working, closing the naked-call window between "call closed" and "shares sold".
#   [FIX-12] Solvency-close cooldown raised to comfortably outlast the ~3min account-summary
#            refresh cycle, so one stale ExcessLiquidity reading can't trigger repeat closes.
#   [FIX-13] Bare-share auto-liquidation is restricted to symbols in CANDIDATE_UNIVERSE, so
#            the bot never sells an unrelated existing holding it doesn't understand.
#   [FIX-14] Unfilled NEW-position orders (buy-write combos, sell-to-open calls) are
#            cancelled at end-of-day shutdown so nothing carries a stale limit price into
#            the next session. Orders resolving EXISTING risk (buy-to-close, share
#            liquidation, short-cover) are deliberately left running, never interrupted.
#   [FIX-15] Exit logic was judging a covered call purely on the OPTION's price: a falling
#            stock makes its short call cheap (misread as "profit capture") and a rising
#            stock makes it expensive (misread as "stop loss") — the option and the stock
#            leg can point in opposite directions and only the option was ever checked.
#            monitor_exit_targets/monitor_leg_exit_targets now compute the COMBINED
#            (stock + call) P&L before acting: it gates whether a "profit capture" is
#            really a win, whether a "stop loss" is really a loss (and skips the forced
#            buy-to-close if the stock rallied enough that the position is net positive),
#            and adds a real combined stop-loss that fires on total loss regardless of what
#            the option price alone says.
# =====================================================================================


# 🧮 PURE PYTHON BLACK-SCHOLES MATH
def pure_python_norm_cdf(x):
    return (1.0 + math.erf(x / math.sqrt(2.0))) / 2.0

def calculate_black_scholes_value(stock_price, strike, days_to_expiry, risk_free_rate, volatility):
    if stock_price <= 0 or strike <= 0 or days_to_expiry <= 0 or volatility <= 0:
        return 0.0
    T = days_to_expiry / 365.0
    d1 = (math.log(stock_price / strike) + (risk_free_rate + 0.5 * volatility ** 2) * T) / (volatility * math.sqrt(T))
    d2 = d1 - volatility * math.sqrt(T)
    call_price = stock_price * pure_python_norm_cdf(d1) - strike * math.exp(-risk_free_rate * T) * pure_python_norm_cdf(d2)
    return round(call_price, 2)


def solve_strike_for_target_delta(stock_price, days_to_expiry, risk_free_rate, volatility, target_delta):
    """Analytically solves for the call strike whose Black-Scholes delta
    (~= N(d1)) equals target_delta, given today's live stock price and
    implied vol."""
    if stock_price <= 0 or days_to_expiry <= 0 or volatility <= 0:
        return None
    if not (0.0 < target_delta < 1.0):
        return None
    T = days_to_expiry / 365.0
    try:
        d1 = NormalDist().inv_cdf(target_delta)
    except (ValueError, ZeroDivisionError):
        return None
    try:
        strike = stock_price / math.exp(d1 * volatility * math.sqrt(T) - (risk_free_rate + 0.5 * volatility ** 2) * T)
    except (OverflowError, ValueError):
        return None
    return strike if strike > 0 else None


