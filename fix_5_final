    # ------------------------------------------------------------------ [FIX-6] cash sizing
    def short_stock_market_value(self):
        total = 0.0
        for sym, qty in self._trusted_short_shares.items():
            st = self.symbol_states.get(sym)
            price = st.live_stock_price if st and st.live_stock_price > 0 else 0.0
            total += qty * price
        return total

    def available_cash_for_new_trades(self):
        """Cash the bot may deploy. Never includes short-sale proceeds, never exceeds
        excess liquidity, and is zero while any short stock exists."""
        if BLOCK_NEW_TRADES_WHILE_SHORT and self._trusted_short_shares:
            return 0.0
        cash = self.current_cash - self.short_stock_market_value()
        if self.excess_liquidity_ready:
            cash = min(cash, self.excess_liquidity)
        reserved = sum(self.pending_order_cash.values()) + self._cash_earmarked_this_pass
        return cash - reserved

    # ------------------------------------------------------------------ [FIX-10] exposure cap
    def long_stock_exposure(self):
        """Broker-confirmed long stock value + every working buy-write order + anything
        earmarked earlier in this same evaluation pass. Used to hard-cap total long
        exposure against Net Liquidation so the bot never relies on margin."""
        total = 0.0
        for sym, qty in self._trusted_shares.items():
            st = self.symbol_states.get(sym)
            px = st.live_stock_price if (st and st.live_stock_price > 0) else self._discovered_share_avgcost.get(sym, 0.0)
            total += qty * px
        return total + sum(self.pending_order_cash.values()) + self._cash_earmarked_this_pass

    def count_active_positions(self):
        count = 0
        for state in self.symbol_states.values():
            if state.position_active or any(leg.position_active for leg in state.other_option_legs):
                count += 1
        return count

    # ------------------------------------------------------------------ [FIX-15] combined P&L
    def stock_unrealized_pl(self, sym):
        """Unrealized P&L on the STOCK leg only. Needs a known cost basis; returns 0.0
        (neutral) rather than guessing if we don't have one yet."""
        state = self.symbol_states.get(sym)
        if not state or state.shares_owned <= 0 or state.avg_stock_cost <= 0 or state.live_stock_price <= 0:
            return 0.0
        return (state.live_stock_price - state.avg_stock_cost) * state.shares_owned

    def total_call_unrealized_pl(self, sym):
        """Unrealized P&L across every currently-active short call on this symbol (the
        primary leg plus any extra legs). Option quotes are per-share, so x100 each."""
        state = self.symbol_states.get(sym)
        if not state:
            return 0.0
        total = 0.0
        if state.position_active and state.live_option_ask > 0:
            total += (state.entry_credit - state.live_option_ask) * 100.0 * state.position_quantity
        for leg in state.other_option_legs:
            if leg.position_active and leg.live_option_ask > 0:
                total += (leg.entry_credit - leg.live_option_ask) * 100.0 * leg.position_quantity
        return total

    def combined_position_pl(self, sym):
        """THE fix for the reported bug: total covered-call P&L (stock + every short call
        together), so exit decisions are judged against the position's real risk instead of
        the option price in isolation."""
        return self.stock_unrealized_pl(sym) + self.total_call_unrealized_pl(sym)

    def build_position_snapshot_lines(self):
        lines = []
        for sym, state in sorted(self.symbol_states.items()):
            has_shares = state.shares_owned > 0
            has_primary = state.position_active
            has_extra = any(leg.position_active for leg in state.other_option_legs)
            if not (has_shares or has_primary or has_extra):
                continue
            parts = []
            if has_shares:
                share_value = state.shares_owned * state.live_stock_price
                parts.append(f"{state.shares_owned} sh @ ${state.live_stock_price:,.2f} (${share_value:,.2f})")
            if has_primary:
                live_dte = self.compute_days_to_expiry(state.target_option)
                unrealized = round((state.entry_credit - state.live_option_ask) * 100.0 * state.position_quantity, 2)
                parts.append(
                    f"short {state.position_quantity}x ${state.target_option.strike} call "
                    f"(credit ${state.entry_credit}, now ${state.live_option_ask}, {live_dte:.1f}d left, "
                    f"unrealized {'+' if unrealized >= 0 else ''}${unrealized:,.2f})"
                )
            for leg in state.other_option_legs:
                if not leg.position_active:
                    continue
                live_dte = self.compute_days_to_expiry(leg.contract)
                unrealized = round((leg.entry_credit - leg.live_option_ask) * 100.0 * leg.position_quantity, 2)
                parts.append(
                    f"short {leg.position_quantity}x ${leg.contract.strike} call [{leg.contract.localSymbol}] "
                    f"(credit ${leg.entry_credit}, now ${leg.live_option_ask}, {live_dte:.1f}d left, "
                    f"unrealized {'+' if unrealized >= 0 else ''}${unrealized:,.2f})"
                )
            lines.append(f"   {sym}: " + " | ".join(parts))
        return lines

