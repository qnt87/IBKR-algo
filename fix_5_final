    BENIGN_INFO_CODES = {1100, 1101, 1102, 2103, 2104, 2105, 2106, 2107, 2108, 2119, 2137, 2158, 10349}

    def error(self, reqId, errorCode, errorString, advancedOrderRejectJson=""):
        # [FIX-2] Only REAL failures (IB codes < 1000, excluding the 399 order warning)
        # release order-tracking state. Warnings like 10349 must NOT, otherwise the orphan
        # sweep believes the sale never went in and sells again.
        is_real_failure = errorCode < 1000 and errorCode != 399

        if is_real_failure and reqId in self.pending_order_cash:
            freed = self.pending_order_cash.pop(reqId)
            note = f"↩️ Released ${freed:,.2f} cash reservation for order {reqId} after error/rejection (code {errorCode})."
            print(note)
            self.write_to_notepad(note)

        if is_real_failure and reqId in self.working_share_orders:
            w_sym, w_action, w_qty = self.working_share_orders.pop(reqId)
            self.last_share_activity[w_sym] = time.time()
            if w_action == "SELL":
                self.liquidation_pending_symbols.discard(w_sym)
            note = (f"↩️ {w_sym}: {w_action} {w_qty} order {reqId} failed (code {errorCode}) — "
                    f"will act again only after a fresh position snapshot.")
            print(note)
            self.write_to_notepad(note)
            self.schedule_snapshot_refresh()

        if is_real_failure and reqId in self.close_orders_pending:
            c_sym = self.close_orders_pending.pop(reqId)
            note = f"↩️ {c_sym}: buy-to-close order {reqId} failed (code {errorCode}) — will retry from the next exit check."
            print(note)
            self.write_to_notepad(note)

        if is_real_failure and reqId in self.open_call_orders_pending:  # [FIX-14]
            self.open_call_orders_pending.pop(reqId)

        if errorCode in self.BENIGN_INFO_CODES:
            print(f"ℹ️ [{errorCode}] {errorString}")
            return
        if errorCode == 201:
            msg = (
                f"🚫 IB ERROR [reqId={reqId}] Code 201: {errorString} — ACCOUNT PERMISSION setting. "
                f"Set STANDALONE_COVERED_CALL_PERMISSION_GRANTED=True once IB confirms the permission."
            )
        elif errorCode == 321:
            msg = f"🚫 IB ERROR [reqId={reqId}] Code 321: {errorString} — missing exchange or conId."
        else:
            msg = f"⚠️ IB ERROR [reqId={reqId}] Code {errorCode}: {errorString}"
        print(msg)
        self.write_to_notepad(msg)

